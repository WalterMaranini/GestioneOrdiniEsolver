# Copiare in .env (escluso da git) e compilare. Lo SHA256 equivale alla password: non condividerlo.
ESOLVER_USER=
# si ottiene con: python -m app.esolver cifra
ESOLVER_PASSWORD_SHA256=
ESOLVER_GROUP=WM
# solo se il gruppo ha una password
ESOLVER_GROUP_PWD_SHA256=
# "Sistemi" oppure la ApiKey fornita per le installazioni SIR
ESOLVER_APPID=Sistemi
ESOLVER_URL=https://apiesolver.sistemi.com
